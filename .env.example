# DHIS2 connection config for landing page indicator panel
VITE_DHIS2_BASE_URL=https://your-dhis2-instance.example.org

# Prefer token auth in browser apps. If not set, username/password can be used.
VITE_DHIS2_API_TOKEN=
VITE_DHIS2_USERNAME=
VITE_DHIS2_PASSWORD=

# Exactly 6 indicator IDs are expected (comma-separated).
VITE_DHIS2_INDICATOR_IDS=deId1,deId2,deId3,deId4,deId5,deId6
VITE_DHIS2_INDICATOR_LABELS=Enrollment Rate,Attendance Rate,Completion Rate,Teacher Attendance,Girl Child Enrollment,Safe School Compliance
VITE_DHIS2_INDICATOR_UNITS=%,%,%,%,%,%

# Optional analytics scope
VITE_DHIS2_ORG_UNIT=USER_ORGUNIT
VITE_DHIS2_PERIOD=LAST_12_MONTHS

# Set true to force mock data mode for demos.
VITE_DHIS2_USE_MOCK=false
